{% extends 'base.html.twig' %}

{% block title %}{{ 'tag.show.title'|trans({'%name%': tag.name}) }} - {{ parent() }}{% endblock %}

{% block body_content %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">{{ 'tag.show.heading'|trans({'%name%': tag.name}) }}</h1>
        <a class="btn btn-outline-secondary" href="{{ path('book_index') }}">{{ ux_icon('bi:chevron-left', {class: 'icon'}) }} {{ 'tag.show.back'|trans }}</a>
    </div>

    {% if books is empty %}
        {% include 'book/_empty_state.html.twig' with {variant: 'no_results'} only %}
    {% else %}
        {% include 'book/_table.html.twig' with {books: books, readBooks: readBooks} only %}
    {% endif %}

    {% if pageCount > 1 %}
        {% include 'book/_pager.html.twig' with {page: page, pageCount: pageCount, route: 'tag_show', routeParams: {slug: tag.slug}} only %}
    {% endif %}
{% endblock %}
