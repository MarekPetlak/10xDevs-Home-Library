{% extends 'base.html.twig' %}

{% block title %}{{ 'book.index.title'|trans }} - {{ parent() }}{% endblock %}

{% block body_content %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">{{ 'book.index.heading'|trans }}</h1>
        <a class="btn btn-primary" href="{{ path('book_new') }}">{{ ux_icon('bi:plus-circle', {class: 'icon'}) }} {{ 'nav.book_new'|trans }}</a>
    </div>

    {% if app.user and recommendations is not null %}
        <section id="recommendations" class="pb-4">
            <h2 class="h4 mb-3">{{ 'book.index.recommendations.heading'|trans }}</h2>
            {% if recommendations is empty %}
                <p class="text-body-secondary">{{ 'book.index.recommendations.empty'|trans }}</p>
            {% else %}
                <div class="row g-3">
                    {% for recommendation in recommendations %}
                        <div class="col-md-4">
                            <div class="card h-100" data-testid="recommendation-card">
                                <div class="card-body">
                                    <h3 class="h5 card-title"><a href="{{ path('book_show', {id: recommendation.bookId}) }}">{{ recommendation.title }}</a></h3>
                                    <p class="card-subtitle text-body-secondary mb-2">{{ recommendation.category.translationKey|trans }}</p>
                                    <p class="card-text">{{ 'book.index.recommendations.rating'|trans({'%average%': recommendation.averageRating|number_format(1, ',', ''), '%count%': recommendation.ratingCount}) }}</p>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    {% endif %}

    {% if total > 0 or search.isFiltered %}
        <form method="get" action="{{ path('book_index') }}" role="search" aria-label="{{ 'book.index.search.label'|trans }}" class="row g-3 align-items-end mb-4">
            <div class="col-md">
                <label for="search-title" class="form-label">{{ 'book.index.search.title'|trans }}</label>
                <input type="text" class="form-control" id="search-title" name="title" value="{{ search.title }}">
            </div>
            <div class="col-md">
                <label for="search-author" class="form-label">{{ 'book.index.search.author'|trans }}</label>
                <input type="text" class="form-control" id="search-author" name="author" value="{{ search.author }}">
            </div>
            <div class="col-md">
                <label for="search-category" class="form-label">{{ 'book.index.search.category'|trans }}</label>
                <select class="form-select" id="search-category" name="category">
                    <option value="">{{ 'book.index.search.all_categories'|trans }}</option>
                    {% for category in enum_cases('App\\Enum\\Category') %}
                        <option value="{{ category.value }}"{{ search.category == category ? ' selected' }}>{{ category.translationKey|trans }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary">{{ ux_icon('bi:search', {class: 'icon'}) }} {{ 'book.index.search.submit'|trans }}</button>
                <a class="btn btn-outline-secondary" href="{{ path('book_index') }}">{{ ux_icon('bi:x-circle', {class: 'icon'}) }} {{ 'book.index.search.clear'|trans }}</a>
            </div>
        </form>
    {% endif %}

    {% if books is empty and total == 0 and not search.isFiltered %}
        {% include 'book/_empty_state.html.twig' with {variant: 'empty'} only %}
    {% elseif books is empty %}
        {% include 'book/_empty_state.html.twig' with {variant: 'no_results'} only %}
    {% else %}
        {% include 'book/_table.html.twig' with {books: books, readBooks: readBooks} only %}
    {% endif %}

    {% if pageCount > 1 %}
        {% include 'book/_pager.html.twig' with {page: page, pageCount: pageCount, search: search} only %}
    {% endif %}
{% endblock %}
