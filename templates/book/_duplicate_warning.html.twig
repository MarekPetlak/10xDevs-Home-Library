{#
    Warning shown above the add-book form when similar books already exist. Input: duplicates, a list of DuplicateMatch.
    It only warns; the "Add anyway" button in the form is the user's decision.
#}
<div class="alert alert-warning" role="alert">
    <h2 class="h5 alert-heading">{{ ux_icon('bi:exclamation-triangle', {class: 'icon'}) }} {{ 'book.duplicate.heading'|trans }}</h2>
    <p>{{ 'book.duplicate.hint'|trans }}</p>
    <ul class="mb-0">
        {% for match in duplicates %}
            <li>
                <a href="{{ path('book_show', {id: match.book.id}) }}" target="_blank" rel="noopener">{{ match.book.title }}</a>,
                {{ match.book.authors|map(a => a.fullName)|join(', ') }},
                {{ match.book.publicationYear }}
                <span class="text-body-secondary">({% if match.sameIsbn %}{{ 'book.duplicate.reason.isbn'|trans }}{% endif %}{% if match.sameIsbn and match.sameTitleAndAuthor %}, {% endif %}{% if match.sameTitleAndAuthor %}{{ 'book.duplicate.reason.title_author'|trans }}{% endif %})</span>
            </li>
        {% endfor %}
    </ul>
</div>
