{% extends 'base.html.twig' %}

{% block title %}{{ 'book.new.title'|trans }} - {{ parent() }}{% endblock %}

{% block body_content %}
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <h1 class="h3 mb-3">{{ 'book.new.heading'|trans }}</h1>

            {% if duplicates is defined and duplicates is not empty %}
                <div class="alert alert-warning" role="alert">
                    <h2 class="h5 alert-heading">{{ 'book.duplicate.heading'|trans }}</h2>
                    <p>{{ 'book.duplicate.hint'|trans }}</p>
                    <ul class="mb-0">
                        {% for match in duplicates %}
                            <li>
                                <a href="{{ path('book_show', {id: match.book.id}) }}" target="_blank" rel="noopener">{{ match.book.title }}</a>,
                                {{ match.book.authors|map(a => a.fullName)|join(', ') }},
                                {{ match.book.publicationYear }}
                                ({% if match.sameIsbn %}{{ 'book.duplicate.reason.isbn'|trans }}{% endif %}{% if match.sameIsbn and match.sameTitleAndAuthor %}, {% endif %}{% if match.sameTitleAndAuthor %}{{ 'book.duplicate.reason.title_author'|trans }}{% endif %})
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% else %}
                {# "Add anyway" only exists next to the warning; mark it rendered so form() skips it. #}
                {% do form.confirm_duplicate.setRendered %}
            {% endif %}

            {{ form(form) }}
        </div>
    </div>
{% endblock %}
