{#
    Error page for production (404, 500, ...) in the app layout, instead of Symfony's default page.
    Variables from TwigBundle: status_code, status_text. Uses only the navbar's user check, no database access.
#}
{% extends 'base.html.twig' %}

{% block title %}{{ 'http_error.title'|trans({'%code%': status_code}) }} - {{ parent() }}{% endblock %}

{% block body_content %}
    <div class="text-center py-5">
        {{ ux_icon(status_code == 404 ? 'bi:search' : 'bi:exclamation-triangle', {class: 'icon-lg icon-accent-2'}) }}
        <p class="num text-body-secondary mt-3 mb-1">{{ status_code }}</p>
        <h1 class="h2">{{ (status_code == 404 ? 'http_error.not_found' : 'http_error.generic')|trans }}</h1>
        <p class="text-body-secondary">{{ (status_code == 404 ? 'http_error.not_found_text' : 'http_error.generic_text')|trans }}</p>
        <a class="btn btn-primary" href="{{ path('book_index') }}">{{ ux_icon('bi:arrow-left', {class: 'icon'}) }} {{ 'book.show.back'|trans }}</a>
    </div>
{% endblock %}
